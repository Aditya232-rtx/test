<%- include('partials/header') %>

<main class="container" style="padding-top: 40px; padding-bottom: 80px;">
  <!-- Header Title & Overview -->
  <div class="glass-card" style="margin-bottom: 30px; background: linear-gradient(135deg, rgba(18, 24, 38, 0.9), rgba(28, 38, 58, 0.9));">
    <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 20px;">
      <div>
        <div style="display: flex; align-items: center; gap: 10px;">
          <span style="font-size: 2rem;">🎯</span>
          <h1 style="font-size: 2rem; font-weight: 800;">Vulnerabilities Dashboard & Scoreboard</h1>
        </div>
        <p style="color: var(--text-muted); font-size: 0.95rem; margin-top: 6px; max-width: 750px;">
          Target index for evaluating Web Vulnerability Scanners (OWASP ZAP, Burp Suite, Nuclei, Nikto) and practicing manual penetration testing.
        </p>
      </div>

      <!-- Quick Stats Counter -->
      <div style="display: flex; gap: 16px;">
        <div style="background: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.3); border-radius: 8px; padding: 10px 16px; text-align: center;">
          <div style="font-size: 1.6rem; font-weight: 800; color: #f87171;"><%= vulnerabilities.length %></div>
          <div style="font-size: 0.75rem; color: #94a3b8; text-transform: uppercase;">Total Flaws</div>
        </div>
        <div style="background: rgba(234, 179, 8, 0.15); border: 1px solid rgba(234, 179, 8, 0.3); border-radius: 8px; padding: 10px 16px; text-align: center;">
          <div style="font-size: 1.6rem; font-weight: 800; color: #facc15;">9+</div>
          <div style="font-size: 0.75rem; color: #94a3b8; text-transform: uppercase;">CWE Targets</div>
        </div>
      </div>
    </div>

    <!-- Filter input -->
    <div style="margin-top: 24px; display: flex; gap: 12px; align-items: center;">
      <input type="text" id="vuln-search" class="form-control" placeholder="Search vulnerabilities by title, CWE, OWASP, or category..." style="max-width: 500px;">
      <span style="font-size: 0.85rem; color: var(--text-muted);">Real-time search</span>
    </div>
  </div>

  <!-- Vulnerability Cards Grid -->
  <div style="display: flex; flex-direction: column; gap: 24px;">
    <% vulnerabilities.forEach(v => { %>
      <div class="glass-card vuln-card" style="border-left: 5px solid <%= v.severity === 'CRITICAL' ? '#ef4444' : (v.severity === 'HIGH' ? '#f59e0b' : '#38bdf8') %>;">
        <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 12px; margin-bottom: 12px;">
          <div>
            <div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
              <span style="font-weight: 800; color: #94a3b8; font-size: 0.9rem;"><%= v.id %></span>
              <h2 style="font-size: 1.35rem; font-weight: 800;"><%= v.name %></h2>
            </div>
            <div style="display: flex; gap: 8px; margin-top: 6px; flex-wrap: wrap;">
              <span class="badge <%= v.severity === 'CRITICAL' ? 'badge-critical' : (v.severity === 'HIGH' ? 'badge-high' : 'badge-medium') %>">
                <%= v.severity %>
              </span>
              <span class="badge" style="background: rgba(255, 255, 255, 0.08); color: #cbd5e1; border: 1px solid var(--border-color);">
                <%= v.cwe %>
              </span>
              <span class="badge" style="background: rgba(255, 255, 255, 0.08); color: #cbd5e1; border: 1px solid var(--border-color);">
                <%= v.owasp %>
              </span>
            </div>
          </div>

          <div style="text-align: right;">
            <span style="font-size: 0.8rem; color: var(--text-muted); display: block;">Affected Endpoint:</span>
            <code style="background: #020617; padding: 4px 8px; border-radius: 4px; color: #38bdf8; font-size: 0.85rem;"><%= v.endpoint %></code>
          </div>
        </div>

        <p style="color: var(--text-muted); font-size: 0.95rem; line-height: 1.6; margin-bottom: 16px;">
          <%= v.description %>
        </p>

        <!-- Technical Details & Payload Box -->
        <div style="background: #020617; border: 1px solid var(--border-color); border-radius: 8px; padding: 16px; margin-bottom: 16px;">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
            <span style="font-size: 0.75rem; text-transform: uppercase; font-weight: 700; color: #f59e0b;">
              🧪 Verified Exploit / Attack Vector:
            </span>
            <button type="button" class="btn btn-outline btn-sm copy-btn" data-payload="<%= v.payloadExample %>" style="padding: 2px 8px; font-size: 0.75rem;">
              Copy Payload
            </button>
          </div>
          <pre style="color: #38bdf8; font-family: monospace; font-size: 0.85rem; white-space: pre-wrap; word-break: break-all; margin: 0;"><%= v.payloadExample %></pre>
        </div>

        <!-- Impact & Remediation -->
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; font-size: 0.85rem; margin-top: 14px; padding-top: 14px; border-top: 1px solid var(--border-color);">
          <div>
            <span style="color: #ef4444; font-weight: 700; display: block; margin-bottom: 2px;">💥 Business / Security Impact:</span>
            <span style="color: var(--text-muted);"><%= v.impact %></span>
          </div>
          <div>
            <span style="color: var(--accent); font-weight: 700; display: block; margin-bottom: 2px;">🛡️ Secure Remediation:</span>
            <span style="color: var(--text-muted);"><%= v.remediation %></span>
          </div>
        </div>
      </div>
    <% }) %>
  </div>
</main>

<%- include('partials/footer') %>
